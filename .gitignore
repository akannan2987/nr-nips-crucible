# ------------------------------------------------------------------
# .gitignore — nr-nips-crucible (Python/FastAPI + React/Vite + podman)
# Keeps secrets, data, and generated files out of the repository.
# Code, docs, and shell scripts are intentionally NOT ignored.
# ------------------------------------------------------------------

# --- Certificates & private keys (NEVER commit) -------------------
# Keep any real certificates backed up outside the repository.
/certs/
*.key
*.pem
*.crt
*.cer
*.csr
*.p12
*.pfx
*.jks
*.der

# --- Environment files / secrets ----------------------------------
.env
.env.*
*.env
!.env.example
secrets.*
credentials.*

# --- Databases, runtime data & backups ----------------------------
/data/
/backups/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.dump
*.bak

# --- Python --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Node / React / Vite ------------------------------------------
node_modules/
client/dist/
dist/
build/
.vite/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs ----------------------------------------------------------
*.log
logs/

# --- OS junk -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editors / IDEs ------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Local AI-assistant settings ----------------------------------
.claude/settings.local.json

# --- Local working notes (not for publication) --------------------
crucible-costar-prompt.md
# CLAUDE.md is auto-loaded by Claude Code every session. It is a symlink to
# crucible-costar-prompt.md above, so it carries the same internal notes and
# must never be published either.
CLAUDE.md
CLAUDE.local.md
.claude/

# --- Upload templates: only the sanitized, synthetic templates are
#     tracked. Any other workbook dropped in here (a real export used
#     for testing) stays local. -----------------------------------
docs/excel-templates/**/*.xls*
docs/excel-templates/**/*.sdf
docs/excel-templates/**/*.csv
!docs/excel-templates/**/*_template.csv
!docs/excel-templates/**/*_template.xlsx
!docs/excel-templates/**/*_template.sdf
!docs/excel-templates/samples/Upload_Sample_Template.xlsx
